# Local emulators: no real credentials or billing required.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-peerwave
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-peerwave.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
AI_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Production: replace public Firebase settings; remove BOTH emulator host variables
# and set NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false. Use Application Default
# Credentials, or private server environment variables below. Never commit them.
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
